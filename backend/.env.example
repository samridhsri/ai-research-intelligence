# Postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=arxiv_rag
PGUSER=arxiv
PGPASSWORD=arxiv

# Embedding provider: "local" (bge-small) or "openai" (default)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# OpenAI (required for embeddings & LLM synthesis)
OPENAI_API_KEY=your-openai-api-key

# Pinecone Serverless Vector DB
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=arxiv-research

# Supabase Storage Configuration (for PDF storage)
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=research-docs

# Sentry Monitoring
SENTRY_DSN=your-sentry-dsn-url

# LangSmith LLM Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=arxiv-intelligence-platform


